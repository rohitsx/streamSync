{
  "version": "1.0.0",
  "manifest_version": 3,
  "name": "StreamSync",
  "description": "This is a Chrome extension built with React and TypeScript",
  "action": {
    "default_popup": "./index.html"
  },
  "icons": {
    "128": "./images/icon128.png"
  },
  "background": {
    "service_worker": "script/bg.js",
    "type": "module"
  },
  "minimum_chrome_version": "92",
  "permissions": ["tabs", "identity", "cookies", "scripting"],
  "host_permissions": ["https://localhost:8000/api/*"],
  "web_accessible_resources": [
    {
      "resources": ["index.html"],
      "matches": ["*://*/*"]
    }
  ],

  "content_scripts": [
    {
      "matches": ["https://blank.org/"],
      "js": ["assets/content.js"],
      "type": "module"
    }
  ]
}
